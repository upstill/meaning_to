{
  "buildCommand": "bash build_vercel.sh",
  "outputDirectory": "build/web",
  "functions": {
    "api/index.js": {
      "runtime": "nodejs22.x"
    },
    "api/test.js": {
      "runtime": "nodejs22.x"
    },
    "api/simple.js": {
      "runtime": "nodejs22.x"
    }
  },
  "rewrites": [
    {
      "source": "/auth/callback",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/$1"
    }
  ]
} 