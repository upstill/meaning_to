{
  "buildCommand": "flutter build web",
  "outputDirectory": "build/web",
  "functions": {
    "api/index.js": {
      "runtime": "nodejs18.x"
    },
    "api/test.js": {
      "runtime": "nodejs18.x"
    },
    "api/simple.js": {
      "runtime": "nodejs18.x"
    }
  },
  "rewrites": [
    {
      "source": "/auth/callback",
      "destination": "/build/web/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/build/web/$1"
    }
  ]
} 