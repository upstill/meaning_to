{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "public": true,
  "github": {
    "silent": true
  },
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/join", "destination": "/index.html" },
    { "source": "/category/:path*", "destination": "/index.html" },
    { "source": "/auth/:path*", "destination": "/index.html" }
  ]
}