{
  "manifest_version": 3,
  "name": "Send to RouzMe",
  "version": "1.0.1",
  "description": "Send the current page (link + title) to RouzMe as a new task.",
  "permissions": ["activeTab"],
  "host_permissions": [
    "https://rouzme.com/*"
  ],
  "action": {
    "default_title": "Send this page to RouzMe",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
