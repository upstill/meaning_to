# Environment variables for local development and deployment
# Copy this file to .env and fill in your actual credentials
# NEVER commit the .env file with real credentials to git!

# Supabase Configuration
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# YouTube API Configuration (optional - only needed for YouTube features)
# YOUTUBE_API_KEY=your_youtube_api_key_here

# OMDb API Configuration (optional - for enhanced IMDb metadata)
# Get your free API key at: http://www.omdbapi.com/apikey.aspx
# Free tier: 1,000 API calls/day
# If not set, will fall back to HTML scraping for IMDb links
OMDB_API_KEY=your_omdb_api_key_here
