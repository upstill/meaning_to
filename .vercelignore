# Ignore source files - we only need the built web app and API
android/
ios/
linux/
macos/
windows/
test/
lib/
.dart_tool/
.idea/
.vscode/
*.log
*.iml
.flutter-plugins
.flutter-plugins-dependencies
.packages
pubspec.lock
pubspec.yaml

# Ignore build artifacts except web output
build/

# Ignore docs and config. NOTE: anchor docs/ to the repo root (leading slash)
# so it doesn't also strip the Flutter-bundled asset at assets/docs/help.md.
/docs/
documents/
supabase/
*.sql
*.md
*.sh
*.p8

# One-off RSS feed (feed/*.html + feed/feed.xml ARE served for a Substack
# import; the generator script is not). Remove the feed/ dir to back it all out.
feed/*.dart

# Node modules
node_modules/

# Git
.git/

# Keep these:
!web/
!api/
# In-app web Help loads this bundled asset; the *.md rule above would strip it.
!assets/docs/help.md
