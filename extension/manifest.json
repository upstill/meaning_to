{
  "manifest_version": 3,
  "name": "Send to ROUZME",
  "version": "1.0.0",
  "description": "Send the current page (link + title) to ROUZME as a new task.",
  "permissions": ["activeTab"],
  "action": {
    "default_title": "Send this page to ROUZME",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
